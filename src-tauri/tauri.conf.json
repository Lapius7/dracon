{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dracon",
  "version": "0.1.0",
  "identifier": "com.lapius7.dracon",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNUY5M0U1NEY3MTQ2MkEKUldRcVJuRlA1Wk5mZ0lLQ1FFZVZPa2gwYnU0bFZOU3gvZEY3cmkrWjBBaG9kSkZCekVmVUNGRnEK",
      "endpoints": [
        "https://github.com/Lapius7/dracon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}